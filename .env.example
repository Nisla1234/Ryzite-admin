# RYZITE Control Centre — Runtime & Deployment Environment Variables
# Never invent credentials or commit real secret values.

# Authentication & Webhook Security
SESSION_SECRET=
ENQUIRY_WEBHOOK_SECRET=

# Sanity CMS (project hnm8jy5w / dataset production — Editor write token for drafts & publishing)
SANITY_API_TOKEN=

# Google Analytics 4 (service account credentials for GA4 Data API)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Google PageSpeed Insights (optional; higher quota for scheduled reports)
PAGESPEED_API_KEY=

# AI Provider (configure one server-side key to enable generative AI synthesis & drafts)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Transactional Email Provider (optional; verified domain sender via Resend)
RESEND_API_KEY=
EMAIL_FROM=

# GitHub (optional; needed only for private repository access or automated pull requests)
GITHUB_TOKEN=

# Cloudflare Workers & D1 deployment automation
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=